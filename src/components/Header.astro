---
import WhatsAppButton from './WhatsAppButton.astro';
import { negocio } from '../data/negocio.js';
import { url } from '../utils/url.js';

const links = [
  { href: url('/#categorias'), label: 'Catálogo' },
  { href: url('/contato/'), label: 'Contato' },
];

const atual = Astro.url.pathname;
---

<header class="header">
  <div class="container header__inner">
    <a href={url('/')} class="brand" aria-label={`${negocio.nome} — página inicial`}>
      <span class="brand__mark" aria-hidden="true">☕</span>
      <span class="brand__name">{negocio.nome}</span>
    </a>

    <nav class="nav" aria-label="Navegação principal">
      <ul class="nav__list">
        {links.map((l) => (
          <li>
            <a href={l.href} class:list={['nav__link', { 'is-active': atual === l.href }]}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__cta">
      <WhatsAppButton label="Pedir" />
    </div>
  </div>
</header>

<style>
  .header {
    background-color: var(--preto);
    color: var(--creme);
    border-bottom: 1px solid rgba(246, 241, 231, 0.12);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.85rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--creme);
    white-space: nowrap;
  }

  .brand__mark {
    font-size: 1.2rem;
  }

  .nav {
    margin-inline: auto;
  }

  .nav__list {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  .nav__link {
    color: rgba(246, 241, 231, 0.85);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--ambar-texto);
  }

  .header__cta :global(.btn) {
    padding: 0.6rem 1.1rem;
  }

  @media (max-width: 48rem) {
    .header__inner {
      flex-wrap: wrap;
      gap: 0.75rem 1rem;
    }

    .nav {
      order: 3;
      width: 100%;
      margin-inline: 0;
    }

    .header__cta {
      margin-left: auto;
    }
  }
</style>
